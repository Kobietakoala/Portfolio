# =================================
# Laravel App Configuration - PROD
# =================================
APP_NAME=Portfolio
APP_ENV=production
APP_KEY=generate_new_production_key_here
APP_DEBUG=false
APP_URL=https://portfolio.example.com

# =================================
# Logging Configuration
# =================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =================================
# Database Configuration - PROD
# =================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio_prod
DB_USERNAME=laravel_prod
DB_PASSWORD=strong_production_password

# =================================
# Cache & Session Configuration
# =================================
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# =================================
# Redis Configuration
# =================================
REDIS_HOST=redis
REDIS_PASSWORD=redis_production_password
REDIS_PORT=6379

# =================================
# Mail Configuration - PROD
# =================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-service.com
MAIL_PORT=587
MAIL_USERNAME=your_production_email_username
MAIL_PASSWORD=your_production_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@portfolio.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =================================
# AWS S3 Configuration (optional)
# =================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=portfolio-production-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

# =================================
# Security Headers
# =================================
SECURE_HEADERS=true

# =================================
# Performance Settings
# =================================
OPCACHE_ENABLED=true